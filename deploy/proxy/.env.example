# Copy to .env next to this file and fill in. Not used by ChargeOnSolar itself.

# The domain registered at TransIP; projects become <name>.<domain>.
DOMAIN=example.com
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=you@example.com
# The TransIP account name the API key belongs to. The key itself goes in
# transip.key next to this file.
TRANSIP_LOGIN=
