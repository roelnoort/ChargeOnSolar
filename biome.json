{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!.agents", "!.claude"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "es5",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        "noFloatingPromises": "error"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["better-sqlite3", "drizzle-orm", "drizzle-orm/**"],
                "message": "Only the storage module touches the database: call its public functions from storage/index.ts."
              },
              {
                "group": ["**/storage/*", "!**/storage/index.ts"],
                "message": "Import the storage module through its single public entry, storage/index.ts."
              }
            ]
          }
        }
      }
    }
  },
  "assist": {
    "enabled": true
  }
}
