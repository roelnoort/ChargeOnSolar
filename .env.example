# Copy to .env (next to this file, in the repo root) and fill in. Without SMTP_HOST the server
# writes Login codes to its log instead of emailing them: for development only.

# Lettermint's SMTP relay in production: take host, user and password from
# the Lettermint dashboard.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The sender, on a domain Lettermint has verified.
MAIL_FROM="ChargeOnSolar <login@example.com>"

# Enphase (Solar production, display-only). scripts/setup-devices.sh fills in
# the API key, client ID and secret, and the system ID.
ENPHASE_API_KEY=
ENPHASE_CLIENT_ID=
ENPHASE_CLIENT_SECRET=
ENPHASE_SYSTEM_ID=
# Encrypts the Enphase refresh token the server stores. Make one with
# `openssl rand -hex 32`. Changing it means running `pnpm enphase login` again.
ENPHASE_TOKEN_KEY=
